    ' --- Entity Associations (with labeled relationship types) ---
    User "1" *-- "0..*" Lease           : <<Composition>>
    User "1" *-- "0..*" Notification    : <<Composition>>
    User "1" *-- "0..*" MediaFile       : <<Composition>>
    User "1" o-- "0..*" ServiceHour     : <<Aggregation>>
    User "1" o-- "0..*" FlashTrade      : <<Aggregation>>
    User "1" o-- "0..*" Donation        : <<Aggregation>>
    User "1" o-- "0..*" Vote            : <<Aggregation>>
    User "1" o-- "0..*" AdviceQuestion  : <<Aggregation>>
    User "1" o-- "0..*" AdviceAnswer    : <<Aggregation>>
    User "1" o-- "0..1" Waitlist        : <<Aggregation>>

    Plot "1" *-- "0..*" Lease           : <<Composition>>
    Plot "1" o-- "0..*" PestReport      : <<Aggregation>>
    Plot "1" o-- "0..*" Inspection      : <<Aggregation>>

    Tool "1" *-- "0..*" ToolReservation : <<Composition>>
    Tool "1" o-- "0..*" DamageReport    : <<Aggregation>>

    AdviceQuestion "1" *-- "0..*" AdviceAnswer : <<Composition>>
    Proposal "1" *-- "0..*" Vote               : <<Composition>>
    Shift "1" o-- "0..*" ShiftSwapRequest      : <<Aggregation>>
    Lease --> Plot                             : <<Association>>
    Lease --> User                             : <<Association>>
    ToolReservation --> Tool                   : <<Association>>
    ToolReservation --> User                   : <<Association>>
}

