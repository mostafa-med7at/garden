@startuml Class_Diagram_V2
title Class Diagram — Version 2\n(Intermediate: Based on Interaction Diagrams, Before Design Patterns)

skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam shadowing true
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundcorner 8

skinparam class {
    BackgroundColor      #FFFFFF
    BorderColor          #2d6a4f
    FontColor            #1a1a2e
    HeaderBackgroundColor #d8f3dc
    StereotypeFontColor  #40916c
    AttributeFontColor   #333333
    ArrowColor           #2d6a4f
}

skinparam note {
    BackgroundColor #f0fdf4
    BorderColor     #52b788
    FontColor       #1a1a2e
}

' ===========================================================
' PACKAGE: Core / Infrastructure
' ===========================================================
package "Core / Infrastructure" #f0fdf4 {

    class Database {
        - instance : Database  {static}
        - connection : PDO
        --
        + {static} getInstance() : Database
        + getConnection() : PDO
    }

    abstract class Controller {
        # model(name : string) : Model
        # view(view : string, data : array) : void
    }

    abstract class Model {
        # db : PDO
        --
        + __construct()
    }

    class View {
        + {static} render(viewPath : string, data : array) : void
    }

    Model "uses" --> Database : <<uses>>
}

